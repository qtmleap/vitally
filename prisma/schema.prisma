generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma/client"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

model User {
  id          String   @id
  email       String
  displayName String?  @map("display_name")
  photoUrl    String?  @map("photo_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  foods         Food[]
  meals         Meal[]
  exercises     Exercise[]
  mealTemplates MealTemplate[]
  profile       UserProfile?
  aiUsage       AiUsage[]

  @@map("users")
}

model UserProfile {
  id            String   @id @default(dbgenerated("(lower(hex(randomblob(16))))"))
  userId        String   @unique @map("user_id")
  age           Int
  heightCm      Float    @map("height_cm")
  weightKg      Float    @map("weight_kg")
  bodyFatPct    Float?   @map("body_fat_pct")
  gender        String
  activityLevel String   @map("activity_level")
  goal           String
  calorieGoal    Int      @map("calorie_goal")
  aiAdviceModel  String?  @map("ai_advice_model")
  aiUtilityModel String?  @map("ai_utility_model")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model AiUsage {
  id        String @id @default(dbgenerated("(lower(hex(randomblob(16))))"))
  userId    String @map("user_id")
  date      String
  count     Int    @default(0)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("ai_usage")
}

model Food {
  id        String   @id @default(dbgenerated("(lower(hex(randomblob(16))))"))
  name      String
  calories  Float
  protein   Float    @default(0)
  fat       Float    @default(0)
  carbs     Float    @default(0)
  serving   String   @default("1食分")
  userId    String   @map("user_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  meals          Meal[]
  templateItems  MealTemplateItem[]
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, name])
  @@map("foods")
}

model Meal {
  id        String   @id @default(dbgenerated("(lower(hex(randomblob(16))))"))
  date      String
  mealType  String   @map("meal_type")
  foodId    String   @map("food_id")
  quantity  Float    @default(1)
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  food      Food     @relation(fields: [foodId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("meals")
}

model MealTemplate {
  id        String             @id @default(dbgenerated("(lower(hex(randomblob(16))))"))
  name      String
  mealType  String?            @map("meal_type")
  userId    String             @map("user_id")
  createdAt DateTime           @default(now()) @map("created_at")
  items     MealTemplateItem[]
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("meal_templates")
}

model MealTemplateItem {
  id         String       @id @default(dbgenerated("(lower(hex(randomblob(16))))"))
  templateId String       @map("template_id")
  foodId     String       @map("food_id")
  quantity   Float        @default(1)
  template   MealTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  food       Food         @relation(fields: [foodId], references: [id])

  @@map("meal_template_items")
}

model Exercise {
  id          String   @id @default(dbgenerated("(lower(hex(randomblob(16))))"))
  date        String
  name        String
  durationMin Int      @map("duration_min")
  calories    Float?
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("exercises")
}
